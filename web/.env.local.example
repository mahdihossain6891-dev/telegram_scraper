# Local live data from FastAPI (MongoDB). Used by `npm run dev`.
DASHBOARD_API_URL=http://127.0.0.1:8510

# Threat Intelligence Engine (TIE) — ops page proxy target
TIE_API_URL=http://127.0.0.1:8000
# Optional when TIE AUTH_ENABLED=true
# TIE_API_KEY=
# TIE_BEARER_TOKEN=

# Console role for TIE page gating (viewer | analyst | senior_analyst | administrator)
# NEXT_PUBLIC_TIE_ROLE=administrator

# Optional: remote raw export.json URL for cloud/static demos
# EXPORT_JSON_URL=
