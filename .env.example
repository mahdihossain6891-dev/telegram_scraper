# Telegram API credentials — obtain from https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Optional: phone number for authentication (international format, e.g. +1234567890)
TELEGRAM_PHONE=

# Optional: test channel bot (create with @BotFather, add bot as channel admin)
TELEGRAM_BOT_TOKEN=
TEST_CHANNEL_USERNAME=osint_test_lab

# Telegram alerts (bot DMs you or posts to a channel when new flagged msgs are scraped)
TELEGRAM_ALERTS_ENABLED=0
TELEGRAM_ALERT_CHAT_ID=
# Examples: 123456789 (your user id) or @osint_test_lab
TELEGRAM_ALERT_ON_SCRAPE=1
TELEGRAM_ALERT_MULTI_CATEGORY_ONLY=0
TELEGRAM_ALERT_MIN_KEYWORDS=1
TELEGRAM_ALERT_COOLDOWN_SECONDS=60

# Session file name (stored in data/ directory)
TELEGRAM_SESSION_NAME=telegram_scraper

# Database (MongoDB via Docker: docker compose up -d)
MONGODB_URI=mongodb://127.0.0.1:27017/telegram_scraper
DATABASE_URL=mongodb://127.0.0.1:27017/telegram_scraper

# Simulation mode — isolated Mongo database for dummy scrapes / AI training data
# SIMULATION_SIMULATION_DATABASE_NAME=telegram_scraper_simulation
# SIMULATION_LIVE_DATABASE_NAME=telegram_scraper

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Application directories (relative to project root)
DATA_DIR=data
EXPORTS_DIR=exports

# Auto-update loop (auto_update.bat)
AUTO_UPDATE_SCRAPE_TARGET=all
AUTO_UPDATE_SCRAPE_LIMIT=1000

# Dashboard scrape control (keyword-filtered, monitored channels only)
# SCRAPE_MONITORED_SCOPE=non-private
# SCRAPE_MESSAGE_LIMIT=500
# SCRAPE_INCLUDE_PRIVATE=0
AUTO_UPDATE_INTERVAL_MINUTES=5
AUTO_UPDATE_SCRAPE_LIMIT=1000
AUTO_UPDATE_BOT_POST=0
AUTO_UPDATE_SYNC_VERCEL=1
AUTO_UPDATE_GIT_PUSH=0

# ---------------------------------------------------------------------------
# Sébastien / AI providers (optional)
# AI_MODEL_CACHE_TTL_SECONDS=300
# AI_CHAT_PROVIDER: ollama | openrouter | lmstudio | openai_compatible | local | none
# ``local`` is an alias for ``ollama``.
# ---------------------------------------------------------------------------
# AI_ENABLED=true
# AI_CHAT_PROVIDER=ollama
# AI_CHAT_MODEL=llama3.2
# AI_EMBEDDING_PROVIDER=ollama
# AI_EMBEDDING_MODEL=nomic-embed-text
# AI_API_BASE_URL=http://127.0.0.1:11434
# AI_API_KEY=
#
# OpenRouter example (chat via OpenRouter, embeddings via local Ollama):
# AI_CHAT_PROVIDER=openrouter
# AI_CHAT_MODEL=openai/gpt-4o-mini
# AI_EMBEDDING_PROVIDER=local
# AI_EMBEDDING_MODEL=nomic-embed-text
# AI_API_BASE_URL=https://openrouter.ai/api/v1
# AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
# AI_API_KEY=sk-or-v1-...
# OPENROUTER_API_KEY=sk-or-v1-...   # optional alias for AI_API_KEY
#
# LM Studio example:
# AI_CHAT_PROVIDER=lmstudio
# AI_CHAT_MODEL=local-model

# ---------------------------------------------------------------------------
# TIE integration (Threat Intelligence Engine → Console upload)
# TIE posts to POST /api/intelligence/reports with Bearer auth.
# Must match TIE's THREAT_CONSOLE_API_KEY.
# ---------------------------------------------------------------------------
# TIE_INGEST_API_KEY=dev-tie-console-shared-key
# THREAT_CONSOLE_API_KEY=dev-tie-console-shared-key
# TIE_API_URL=http://127.0.0.1:8000
# TIE_ENGINE_ENABLED=0
# AI_API_BASE_URL=http://127.0.0.1:1234/v1
# AI_API_KEY=
