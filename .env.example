# Telegram API credentials — obtain from https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Optional: phone number for authentication (international format, e.g. +1234567890)
TELEGRAM_PHONE=

# Optional: test channel bot (create with @BotFather, add bot as channel admin)
TELEGRAM_BOT_TOKEN=
TEST_CHANNEL_USERNAME=osint_test_lab

# Session file name (stored in data/ directory)
TELEGRAM_SESSION_NAME=telegram_scraper

# Database
DATABASE_URL=sqlite:///data/telegram_scraper.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Application directories (relative to project root)
DATA_DIR=data
EXPORTS_DIR=exports

# Auto-update loop (auto_update.bat)
AUTO_UPDATE_SCRAPE_TARGET=1
AUTO_UPDATE_INTERVAL_MINUTES=5
AUTO_UPDATE_SCRAPE_LIMIT=1000
AUTO_UPDATE_BOT_POST=0
AUTO_UPDATE_SYNC_STREAMLIT=1
AUTO_UPDATE_SYNC_VERCEL=1
AUTO_UPDATE_GIT_PUSH=0
